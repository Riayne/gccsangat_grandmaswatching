:root {
    --truck-pink: rgb(230, 40, 90);
    --truck-yellow: rgb(255, 214, 51);
    --truck-green: rgb(30, 170, 120);
    --ink: rgb(40, 18, 40);
}

.root {
    flex-grow: 1;
    -unity-font-definition: url("project://database/Assets/Fonts/NotoNastaliqUrdu_SDF.asset");
    -unity-text-generator: advanced;
    color: white;
}

Label, Button {
    -unity-text-generator: advanced;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.hidden {
    display: none;
}

.truck-frame {
    background-image: url("project://database/Assets/Art/truck_frame.png");
    -unity-slice-left: 34;
    -unity-slice-top: 34;
    -unity-slice-right: 34;
    -unity-slice-bottom: 34;
}

/* HUD */
.hud {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    height: 150px;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
    padding: 20px 60px;
}

.hud-label {
    font-size: 50px;
}

.score {
    color: var(--truck-yellow);
    transition-duration: 0.08s;
}

.score--pop {
    scale: 1.3 1.3;
}

/* World-anchored labels */
.box-label {
    position: absolute;
    translate: -50% -50%;
    font-size: 34px;
    color: rgb(170, 25, 40);
}

.bubble {
    position: absolute;
    translate: -50% -100%;
    background-image: url("project://database/Assets/Art/bubble.png");
    -unity-slice-left: 40;
    -unity-slice-top: 40;
    -unity-slice-right: 40;
    -unity-slice-bottom: 40;
    padding: 18px 36px 28px 36px;
}

.bubble-text {
    font-size: 40px;
    color: var(--ink);
}

.praise {
    position: absolute;
    top: 30%;
    left: 0;
    right: 0;
    font-size: 120px;
    color: var(--truck-yellow);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--truck-pink);
    opacity: 0;
    scale: 0.4 0.4;
    transition-duration: 0.25s;
}

.praise--show {
    opacity: 1;
    scale: 1 1;
}

/* Full-screen panels (title + game over) */
.screen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 6, 25, 0.78);
    justify-content: center;
    align-items: center;
}

.card {
    width: 90%;
    align-items: center;
    padding: 60px 50px;
}

.title {
    font-size: 96px;
    color: var(--truck-yellow);
    margin-bottom: 10px;
}

.tagline {
    font-size: 54px;
    color: white;
    margin-bottom: 40px;
}

.how-to {
    align-items: stretch;
    margin-bottom: 40px;
}

.how-to-line {
    font-size: 40px;
    color: rgb(220, 230, 255);
    margin-bottom: 8px;
}

.big-button {
    font-size: 64px;
    color: var(--ink);
    background-color: var(--truck-yellow);
    border-width: 6px;
    border-color: var(--truck-pink);
    border-radius: 40px;
    padding: 18px 70px 30px 70px;
    transition-duration: 0.1s;
}

.big-button:active {
    scale: 0.94 0.94;
    background-color: var(--truck-green);
}

.caught {
    font-size: 130px;
    color: var(--truck-pink);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: white;
    margin-bottom: 20px;
}

.result {
    font-size: 60px;
    margin-bottom: 10px;
}

.new-best {
    font-size: 54px;
    color: var(--truck-green);
    margin-bottom: 20px;
}
