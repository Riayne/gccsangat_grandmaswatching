# Repository root. The Unity project lives in Source/ and has its own .gitignore
# (Library/, Temp/, Logs/, Obj/, UserSettings/, IDE files, keystores...).

# Builds/: commit only the final APK, not Unity's backup/symbol folders
/Builds/*
!/Builds/*.apk

# Gradle/Unity build logs
/build/

# Signing files and secrets: never commit
*.keystore
*.jks
*.p12
*.pfx
*.mobileprovision
.env

# Local tool settings
/.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db
desktop.ini
